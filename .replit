modules = ["nodejs-20"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DAO Governance Development Server"

[[workflows.workflow]]
name = "DAO Governance Development Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd dao-governance && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
